    "clsx": "^2.1.1",
    "cmdk": "^1",
    "date-fns": "^3",
    "lucide-react": "^0.400",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7",
    "react-resizable-panels": "^2",
    "react-router-dom": "^7",
    "sonner": "^1.5",
