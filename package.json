{
  "name": "qraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first developer toolbox built with Rust + Tauri + React",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
