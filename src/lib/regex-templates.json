{
  "$comment": "常用正则模板库(单一数据源):前端 Regex Lab 模板页签与 Rust 集成测试共读。所有 pattern 必须可在 Rust regex 引擎编译(禁后向引用/环视/回溯断言)。",
  "categories": [
    {
      "id": "web",
      "templates": [
        {
          "pattern": "https?://[^\\s<>\"')]+",
          "flags": "gi",
          "tplKey": "url",
          "sample": "官网 https://example.com/docs 与镜像 http://mirror.example.org 均可访问"
        },
        {
          "pattern": "[\\w.+-]+@[\\w-]+\\.[\\w.]+",
          "flags": "gi",
          "tplKey": "email",
          "sample": "联系人:alice@example.com,备用 bob.smith+tag@sub.example.co.uk"
        },
        {
          "pattern": "^https?://([^/:]+)",
          "flags": "gm",
          "tplKey": "domain",
          "sample": "https://api.example.com/v1\nhttp://mirror.example.org:8080/list\nhttps://127.0.0.1/debug"
        },
        {
          "pattern": "^(?:\\d{1,3}\\.){3}\\d{1,3}$",
          "flags": "gm",
          "tplKey": "ipv4",
          "sample": "192.168.1.1\n10.0.0.256\n255.255.255.255\nnot-an-ip"
        },
        {
          "pattern": "<([a-z][\\w-]*)(?:\\s[^>]*)?>((?s:.*?))</([a-z][\\w-]*)>",
          "flags": "gi",
          "tplKey": "html_pair",
          "sample": "<div class=\"box\">内容</div><p>段落</p><img src=\"a.png\"><br/>"
        }
      ]
    },
    {
      "id": "datetime",
      "templates": [
        {
          "pattern": "\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])",
          "flags": "g",
          "tplKey": "date_iso",
          "sample": "发布于 2026-09-13,草稿日期 2026-9-3,截止 2026-12-31"
        },
        {
          "pattern": "\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[T ](0\\d|1\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?",
          "flags": "g",
          "tplKey": "datetime_iso",
          "sample": "创建 2026-09-13T09:30:00,更新 2026-09-12 23:59,错误示例 2026-09-13 24:00"
        },
        {
          "pattern": "([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?",
          "flags": "g",
          "tplKey": "time_24h",
          "sample": "上班 09:00,午休 12:30:45,加班到 23:59,非法 24:00"
        },
        {
          "pattern": "([A-Z][a-z]+\\s+\\d{1,2},?\\s+\\d{4})",
          "flags": "g",
          "tplKey": "date_en_long",
          "sample": "Meeting on Monday, March 3, 2025 was moved to Friday, December 19, 2026."
        }
      ]
    },
    {
      "id": "number",
      "templates": [
        {
          "pattern": "[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?",
          "flags": "g",
          "tplKey": "number_float",
          "sample": "整数 42,负数 -7,浮点 3.14,科学计数 6.02e23,-0.5E-3"
        },
        {
          "pattern": "[+-]?\\d{1,3}(?:,\\d{3})*(?:\\.\\d+)?",
          "flags": "g",
          "tplKey": "number_thousands",
          "sample": "单价 1,234.50,总量 12,345,678,不带分隔符 1234567"
        },
        {
          "pattern": "\\b\\d+(?:\\.\\d{1,2})?\\b",
          "flags": "g",
          "tplKey": "currency_amount",
          "sample": "合计 ¥1299.50 与 $99.99,以及 49.999 这类需警惕的写法"
        },
        {
          "pattern": "\\b0x[0-9a-fA-F]+\\b",
          "flags": "g",
          "tplKey": "hex_literal",
          "sample": "颜色 #FFFFFF(非 0x),掩码 0xFF,字节 0xC0A8,变量 0x1G 无效"
        },
        {
          "pattern": "^(?:-?\\d+|-?\\d+\\.\\d+|-?\\d+\\.?\\d*([eE][+-]?\\d+)?)$",
          "flags": "gm",
          "tplKey": "number_line",
          "sample": "3.14\n-42\n1e10\n.\nabc"
        }
      ]
    },
    {
      "id": "text",
      "templates": [
        {
          "pattern": "[\\u4e00-\\u9fff]+",
          "flags": "g",
          "tplKey": "cjk",
          "sample": "Hello 世界,RegEx 工具箱第 2 版上线。"
        },
        {
          "pattern": "\\b[\\w-]+\\b",
          "flags": "g",
          "tplKey": "english_word",
          "sample": "The quick-brown fox jumps over the lazy dog."
        },
        {
          "pattern": ",[ \\t]+|(?:[ \\t])+,|;[ \\t]*",
          "flags": "gm",
          "tplKey": "space_cleanup",
          "sample": "a , b , c ;  d\n,开头,  结尾  ;"
        },
        {
          "pattern": "[ \\t]+$",
          "flags": "gm",
          "tplKey": "trailing_space",
          "sample": "first line   \nsecond line\t\nno-trailing  "
        }
      ]
    },
    {
      "id": "code",
      "templates": [
        {
          "pattern": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "flags": "g",
          "tplKey": "string_double",
          "sample": "name = \"John \\\"Ace\\\" Smith\"; path = \"C:\\\\tools\"; broken = \"abc"
        },
        {
          "pattern": "//.*$",
          "flags": "gm",
          "tplKey": "comment_line",
          "sample": "int x = 1; // 初始化\n// 整行注释\nint y = 2; /* 块注释不算 */"
        },
        {
          "pattern": "/\\*[\\s\\S]*?\\*/",
          "flags": "g",
          "tplKey": "comment_block",
          "sample": "前文 /* 多行\n注释 */ 后文 /* 单行 */ 结束"
        },
        {
          "pattern": "^(?:export\\s+)?(?:async\\s+)?function\\s+([A-Za-z_$][\\w$]*)",
          "flags": "gm",
          "tplKey": "js_function",
          "sample": "function add(a, b) {}\nasync function fetchData() {}\nexport function util() {}\nconst arrow = () => {}"
        },
        {
          "pattern": "fn\\s+([A-Za-z_][\\w]*)",
          "flags": "g",
          "tplKey": "rust_fn",
          "sample": "fn main() {}\npub fn run() {}\nlet closure = |x| x;"
        },
        {
          "pattern": "^(\\s*)(?:#|//)\\s*(.*)$",
          "flags": "gm",
          "tplKey": "log_line",
          "sample": "# 注释行\n代码行\n  // 缩进注释\n正文"
        }
      ]
    }
  ]
}
