<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    bench 二进制专用 manifest。
    tauri-plugin-dialog(rfd common-controls-v6)静态导入 comctl32 v6 的
    TaskDialogIndirect;无 manifest 的 exe 会被 loader 绑到 WinSxS 的
    comctl32 5.82(不导出该函数),bench 进程启动即
    STATUS_ENTRYPOINT_NOT_FOUND。主二进制由 tauri-build 自带 manifest,
    不受影响。此文件经 build.rs 的 cargo:rustc-link-arg-bin 嵌入 bench。
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
