{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qraft",
  "version": "0.2.5",
  "identifier": "cn.wait.qraft",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14200",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qraft",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data: blob:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:; media-src 'self' data: blob:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ws://localhost:14200 http://localhost:14200 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/file-assoc"],
    "externalBin": [],
    "fileAssociations": [
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "纯文本文件",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["json"],
        "name": "JSON Document",
        "description": "JSON 数据文件",
        "mimeType": "application/json",
        "role": "Editor"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["csv"],
        "name": "CSV Document",
        "description": "CSV 表格文件",
        "mimeType": "text/csv",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF 文档",
        "mimeType": "application/pdf",
        "role": "Editor"
      },
      {
        "ext": ["docx", "docm", "doc"],
        "name": "Word Document",
        "description": "Word 文档",
        "mimeType": "application/msword",
        "role": "Editor"
      },
      {
        "ext": ["xlsx", "xlsm", "xls"],
        "name": "Excel Spreadsheet",
        "description": "Excel 表格",
        "mimeType": "application/vnd.ms-excel",
        "role": "Editor"
      },
      {
        "ext": ["pptx", "pptm", "ppt"],
        "name": "PowerPoint Presentation",
        "description": "PowerPoint 幻灯片",
        "mimeType": "application/vnd.ms-powerpoint",
        "role": "Editor"
      },
      {
        "ext": ["log"],
        "name": "Log File",
        "description": "日志文件",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["xml"],
        "name": "XML Document",
        "description": "XML 文档",
        "mimeType": "application/xml",
        "role": "Editor"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML Document",
        "description": "YAML 文档",
        "mimeType": "application/yaml",
        "role": "Editor"
      },
      {
        "ext": ["toml"],
        "name": "TOML Document",
        "description": "TOML 文档",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["ini", "conf", "env"],
        "name": "Configuration Text File",
        "description": "配置文本文件",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["js"],
        "name": "JavaScript Document",
        "description": "JavaScript 源码文件",
        "mimeType": "text/javascript",
        "role": "Editor"
      },
      {
        "ext": ["ts"],
        "name": "TypeScript Document",
        "description": "TypeScript 源码文件",
        "mimeType": "text/typescript",
        "role": "Editor"
      },
      {
        "ext": ["jsx", "tsx"],
        "name": "React Document",
        "description": "React JSX/TSX 文件",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["py"],
        "name": "Python Document",
        "description": "Python 源码文件",
        "mimeType": "text/x-python",
        "role": "Editor"
      },
      {
        "ext": ["rs"],
        "name": "Rust Document",
        "description": "Rust 源码文件",
        "mimeType": "text/rust",
        "role": "Editor"
      },
      {
        "ext": ["go"],
        "name": "Go Document",
        "description": "Go 源码文件",
        "mimeType": "text/x-go",
        "role": "Editor"
      },
      {
        "ext": ["java"],
        "name": "Java Document",
        "description": "Java 源码文件",
        "mimeType": "text/x-java-source",
        "role": "Editor"
      },
      {
        "ext": ["c", "h"],
        "name": "C Document",
        "description": "C 源码与头文件",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["cpp", "hpp"],
        "name": "C++ Document",
        "description": "C++ 源码与头文件",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["sh", "bash"],
        "name": "Shell Script Document",
        "description": "Shell 脚本",
        "mimeType": "application/x-sh",
        "role": "Editor"
      },
      {
        "ext": ["sql"],
        "name": "SQL Document",
        "description": "SQL 脚本",
        "mimeType": "application/sql",
        "role": "Editor"
      },
      {
        "ext": ["vue"],
        "name": "Vue Document",
        "description": "Vue 单文件组件",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["svelte"],
        "name": "Svelte Document",
        "description": "Svelte 组件",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "copyright": "Copyright (c) 2026 Qraft Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local-first developer toolbox",
    "longDescription": "Qraft is a local-first developer toolbox with 10+ offline tools: JSON formatter, Base64, JWT parser, hash calculator, and more. Zero network, zero telemetry.",
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "template": "./windows/installer.nsi",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "providerShortName": "Qraft",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/mecoren/qraft/releases/latest/download/latest.json"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFOUZFMTdDMEQ0RDQ2NEUKUldST1JrME5mT0dmL2tObWhyMkY2TmVpemt5b3dSSVJlanpibHZ0VWtyMEd1bndCcUdleWpLVm4K"
    }
  }
}
