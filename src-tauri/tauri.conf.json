{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qraft",
  "version": "0.1.2",
  "identifier": "cn.wait.qraft",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qraft",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data: blob:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:; media-src 'self' data: blob:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ws://localhost:1420 http://localhost:1420 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "fileAssociations": [
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "description": "Plain text files",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": [
          "json"
        ],
        "name": "JSON Document",
        "description": "JavaScript Object Notation data files",
        "mimeType": "application/json",
        "role": "Editor"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown plain text files",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV Document",
        "description": "Comma-separated values files",
        "mimeType": "text/csv",
        "role": "Editor"
      },
      {
        "ext": [
          "log"
        ],
        "name": "Log File",
        "description": "Plain text log files",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": [
          "xml",
          "yaml",
          "yml",
          "toml",
          "ini",
          "conf",
          "env"
        ],
        "name": "Configuration Text File",
        "description": "Configuration and data text files",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": [
          "js",
          "ts",
          "jsx",
          "tsx",
          "py",
          "rs",
          "go",
          "java",
          "c",
          "h",
          "cpp",
          "hpp",
          "sh",
          "bash",
          "sql",
          "vue",
          "svelte"
        ],
        "name": "Source Code File",
        "description": "Source code files",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "copyright": "Copyright (c) 2026 Qraft Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local-first developer toolbox",
    "longDescription": "Qraft is a local-first developer toolbox with 10+ offline tools: JSON formatter, Base64, JWT parser, hash calculator, and more. Zero network, zero telemetry.",
    "windows": {
      "wix": {
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "providerShortName": "Qraft",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mecoren/qraft/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGRDdCMzU2QUY3NDk4RDcKUldUWG1IU3ZWclBYdjJGOW4rS05mVlVlOEd5M2J5RzRwVWE2S0ZIMnRCUSt6cHYzUlVYV3lXQTMK"
    }
  }
}
