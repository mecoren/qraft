# Qraft 环境变量模板
# 复制此文件为 .env 并按需调整:cp .env.example .env

# ===== 前端 Vite 环境变量 =====
# 应用环境(development | production)
VITE_APP_ENV=development

# 日志级别(trace | debug | info | warn | error)
VITE_LOG_LEVEL=info

# Tauri 环境由 Tauri CLI 自动设置,无需手动配置:
# TAURI_ENV_DEBUG=1(开发模式)
# TAURI_ENV_RELEASE=1(生产模式)

# ===== Tauri Updater 签名密钥(见 PRD 14-build-and-distribution.md §3.4) =====
# 生成命令:pnpm tauri signer generate -w ~/.tauri/qraft.key -p <password>
# 注意:Tauri V2 实际读取的环境变量名为 TAURI_SIGNING_PRIVATE_KEY(_PASSWORD),
#       非 TAURI_PRIVATE_KEY(_KEY_PASSWORD)。
#       本地构建时可设置 TAURI_SIGNING_PRIVATE_KEY_PATH 指向密钥文件路径,
#       CI 通过 TAURI_SIGNING_PRIVATE_KEY 直接传入密钥内容。

# 私钥文件路径(本地构建使用)或私钥内容(CI 使用)
TAURI_SIGNING_PRIVATE_KEY_PATH=
TAURI_SIGNING_PRIVATE_KEY=
# 私钥密码(生成时设置)
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ===== macOS 代码签名与公证(仅生产环境使用) =====
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ===== Windows Authenticode 签名(仅生产环境使用,MVP 阶段不签名) =====
WINDOWS_CERTIFICATE=
WINDOWS_CERTIFICATE_PASSWORD=
